{
  "extends": "@vue/tsconfig/tsconfig.json",
  "compilerOptions": {
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/uni_modules/uni-upgrade-center-app/utils/update-manager": [
        "./src/types/uni-upgrade-center.d.ts"
      ],
      "@/uni_modules/uni-upgrade-center-app/utils/call-check-version": [
        "./src/types/uni-upgrade-center.d.ts"
      ]
    },
    "lib": ["esnext", "dom"],
    "types": ["@dcloudio/types"],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "shims-uni.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/uni_modules"
  ]
}
