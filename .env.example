# ── 必填 ────────────────────────────────────────────────────
# 后端 API 根地址（App 端必须填真实可访问的地址，手机无法访问 localhost）。
# 生产构建（npm run build:app）缺失或仍指向 localhost 时，vite.config.ts 会直接 fail build。
VITE_API_BASE_URL=http://192.168.1.100:8081/api/v1

# ── uni-push 2.0 开关 ───────────────────────────────────────
# @dcloudio/uni-push 已在 package.json 中固定为 3.0.0-4080420251103001
# （务必与其它 @dcloudio/* 完全同版本），manifest.json 也已声明
# app-plus.modules.Push 与 uni-push.push-type，装好依赖后即可置 true。
# 仍需把 src/manifest.json 的 appid 换成真实 DCloud AppID，
# 否则 uni.getPushClientId 拿不到有效 cid（代码会安全降级，不崩溃）。
# 关闭时全部走 no-op，保证工程在插件缺位的情况下仍可编译、可运行。
VITE_PUSH_ENABLED=false

# ── 支付通道（APP-09）───────────────────────────────────────
# iOS 数字内容必须走 StoreKit IAP（App Store 审核要求），已接入 Apple IAP 校验。
# 开关为 false 时 iOS 不展示支付按钮，仅展示说明文案。
VITE_DONATE_ENABLED=false
VITE_DONATE_IOS_ENABLED=false
# Android 原生支付（微信 App Pay / 支付宝）尚未接入后端对账接口，
# 在后端 /donations/wx-app、/donations/alipay 落地前必须保持 false，
# 否则用户点「捐赠」必然失败。
VITE_DONATE_NATIVE_READY=false

# ── 内置管理后台（调试用）────────────────────────────────────
# src/pages/admin/ 不随 C 端发布包开放：生产构建会在 vite.config.ts 里强制置 false。
# 仅在本地 dev / H5 / 真机自定义基座调试时置 true。
VITE_ADMIN_ENABLED=false
