{
    "name" : "idoltrail",
    "appid" : "__UNI__F1F9279",
    "description" : "演唱会、音乐节、见面会等偶像活动信息订阅平台~",
    "versionName" : "0.1.1",
    "versionCode" : "100",
    "transformPx" : false,
    "app-plus" : {
        "usingComponents" : true,
        "nvueStyleCompiler" : "uni-app",
        "compilerVersion" : 3,
        "compatible" : {
            "ignoreVersion" : true
        },
        "splashscreen" : {
            "alwaysShowBeforeRender" : true,
            "waiting" : true,
            "autoclose" : true,
            "delay" : 0
        },
        /* 需要的原生模块：推送、分享、相机、定位。

           Geolocation 只勾选「系统定位」（HBuilderX 3.2.16 起独立出的模块，
           模块标识就是 Geolocation），**不勾选任何三方定位 SDK**：
             · 刻意不声明 Geolocation-Tencent / Geolocation-Baidu
             · 刻意不在 distribute.sdkConfigs.location 填高德 / 腾讯 key
           因此不需要向任何地图厂商申请账号、实名认证或商业授权（5 万元/年起）。
           系统定位只返回 WGS84 经纬度（Android 不支持解析地址），
           城市名由后端天地图逆地理编码解析，见 src/utils/location.ts。 */
        "modules" : {
            "Push" : {},
            "Share" : {},
            "Camera" : {},
            "Geolocation" : {},
            /* OAuth（登录鉴权）：承载 uni 一键登录（univerify）原生能力。
               一键登录的取号逻辑在 SDK 内部，本 App 只调用 uni.preLogin /
               uni.login 拿一次性 access_token + openid，手机号由服务端经
               uniCloud 云函数换取，见 src/utils/univerify.ts。
               ⚠️ 必须用**包含该模块的自定义基座或云打包**安装才能生效，
                  旧基座 / 普通 H5 调试不会有这个入口（前端已做能力探测降级）。 */
            "OAuth" : {}
        },
        /* 启动图：图标资源放在 src/static/ 下，云打包时在 manifest 可视化界面替换 */
        "distribute" : {
            "android" : {
                "label" : "idoltrail",
                "minSdkVersion" : 21,
                "targetSdkVersion" : 34,
                "abiFilters" : [ "armeabi-v7a", "arm64-v8a", "x86_64" ],
                "permissions" : [
                    /* 城市定位（uni.getLocation 系统定位）所需权限。
                       COARSE 精度即可满足「定位到城市」的业务诉求，FINE 一并声明：
                       部分厂商 ROM 的定位服务在仅有 FINE 时才提供 NETWORK_PROVIDER 结果。
                       两项均为运行时权限，需用户主动授权，见 src/utils/privacy.ts。 */
                    "<uses-permission android:name=\"android.permission.ACCESS_COARSE_LOCATION\"/>",
                    "<uses-permission android:name=\"android.permission.ACCESS_FINE_LOCATION\"/>",
                    "<uses-permission android:name=\"android.permission.INTERNET\"/>",
                    "<uses-permission android:name=\"android.permission.ACCESS_NETWORK_STATE\"/>",
                    "<uses-permission android:name=\"android.permission.CHANGE_NETWORK_STATE\"/>",
                    "<uses-permission android:name=\"android.permission.ACCESS_WIFI_STATE\"/>",
                    "<uses-permission android:name=\"android.permission.WAKE_LOCK\"/>",
                    "<uses-permission android:name=\"android.permission.VIBRATE\"/>",
                    "<uses-permission android:name=\"android.permission.POST_NOTIFICATIONS\"/>"
                ],
                "permissionExternalStorage" : {
                    /* request:none 与下方 permissions 列表一致：本 App 不读写公共存储，
                       图片缓存走应用私有目录，无需申请存储权限 */
                    "request" : "none",
                    "prompt" : "本应用不使用公共存储，无需授权"
                },
                "permissionPhoneState" : {
                    /* 设备标识来自 src/utils/device.ts 的 plus.device.uuid，
                       不是 IMEI / 手机号，因此**不申请** READ_PHONE_STATE。
                       申请了反而会触发应用商店的隐私合规问询。 */
                    "request" : "none",
                    "prompt" : "本应用不读取手机状态，设备标识由系统 UUID 生成"
                }
            },
            "ios" : {
                "dSYMs" : false,
                "idfa" : false,
                "capabilities" : {
                    "entitlements" : {
                        "com.apple.developer.associated-domains" : []
                    }
                },
                /* ── Sign in with Apple ──
                           保持注释状态，启用需三步同时完成（缺一按钮必失败）：

                             1. Apple Developer 后台为 App ID 启用 Sign in with Apple；
                             2. 重新生成 provisioning profile；
                              3. 取消下面这行注释，并把 .env.prod 的
                                 VITE_APPLE_LOGIN_ENABLED 置为 true。

                           为什么默认注释而不是直接打开：manifest 声明了 entitlement
                           但描述文件里没有时，云打包会直接失败（签不出包），
                           那会让整个 App 卡在发不出去的状态，比按钮不显示更糟。
                           后端 APPLE_CLIENT_ID / APPLE_TEAM_ID / APPLE_KEY_ID /
                            APPLE_PRIVATE_KEY_PATH 也需就位，见后端 .env.prod。

                        "com.apple.developer.applesignin" : ["Default"]
                         ⚠️ 刻意不声明 NSUserTrackingUsageDescription：
     本 App 未接入任何广告追踪（"idfa": false，代码中无 ATT 调用）。
     声明 ATT 用途却不请求授权，是 App Store 审核的常见拒审点。 */
                "privacyDescription" : {
                    "NSCameraUsageDescription" : "用于拍摄活动海报，便于上传到个人主页",
                    "NSPhotoLibraryUsageDescription" : "用于从相册选择图片作为头像",
                    /* 城市定位：iOS 用系统 CoreLocation，首次调用 uni.getLocation 时由系统弹窗授权。
                       文案必须与实际用途一致，且必须真正申请权限——
                       声明了不申请、或申请了不声明，都会被 App Store 审核挑刺。 */
                    "NSLocationWhenInUseUsageDescription" : "用于根据您所在城市为您预选本地演出，可随时在系统设置中关闭"
                }
            },
            /* uni-push 2.0 的两个开关由**编译器**读取
               （@dcloudio/uni-push/lib/uni.plugin.js → isEnableUniPushV2 / isUniPushOffline），
               两者都正确，客户端才会走厂商离线通道：
                 version:"2"  → 启用 uni-push 2.0
                 offline:true  → 解析到 dist/uni-push.plus.es.js（厂商通道）

               ⚠️ offline 必须为 true。默认的 dist/uni-push.es.js 走个推 GtPush
               长连接（wss://wshzn.gepush.com），后台极易被系统杀死，
               且 iOS 根本没有保活长推送的机制 —— iOS 只能靠 APNs。
               下方 app-plus["uni-push"]["push-type"] 并非编译器读取的字段，
               保留仅供云打包识别，两者缺一不可。 */
            "sdkConfigs" : {
                "push" : {
                    "unipush" : {
                        "version" : "2",
                        "offline" : true,
                        "icons" : {
                            "small" : {
                                "xxhdpi" : "app-icons/72x72.png",
                                "xhdpi" : "app-icons/40x40.png",
                                "hdpi" : "app-icons/29x29.png",
                                "mdpi" : "app-icons/20x20.png"
                            }
                        },
                        "mi" : {}
                    }
                },
                "geolocation" : {
                    "system" : {
                        "__platform__" : [ "ios", "android" ]
                    }
                },
                "maps" : {},
                "oauth" : {
                    "univerify" : {}
                },
                "share" : {}
            },
            /* 分享说明：src/utils/share.ts 走 plus.share.sendWithSystem 调起系统分享面板，
               不依赖微信 / QQ / 微博 SDK，因此这里不需要任何 sdkConfigs 配置。
               若日后要接三方内部分享，需在此填入各厂商 appid / appsecret。
			   图标说明：源图是 app-icons/1024x1024.png（1024x1024，保留原始清晰度供后续再加工），
               下列各尺寸由它等比缩放而来。
               放在**项目根级 app-icons/** 而不是 src/static/ 下，有两个原因：
                 1. src/static/ 会被**原样复制进运行时包**（wgt），这些图只服务于
                    云打包的原生图标 / 启动图，运行时一个字节都用不到；
                    放进去等于每台设备白背 694 KB。
                 2. 刻意不用 unpackage/res/icons/：那是 HBuilderX 的云打包与原生编译
                    **产物目录**（.gitignore 已忽略），图标放进去不会随仓库走，
                    别人克隆后打包必然缺图。app-icons/ 已入库，可自包含。
               路径相对**项目根目录**解析（与 unpackage/res/icons/ 同级语义）。 */
            "icons" : {
                "android" : {
                    "hdpi" : "app-icons/72x72.png",
                    "xhdpi" : "app-icons/96x96.png",
                    "xxhdpi" : "app-icons/144x144.png",
                    "xxxhdpi" : "app-icons/192x192.png"
                },
                "ios" : {
                    "appstore" : "app-icons/1024x1024.png",
                    "ipad" : {
                        "app" : "app-icons/76x76.png",
                        "app@2x" : "app-icons/152x152.png",
                        "notification" : "app-icons/20x20.png",
                        "notification@2x" : "app-icons/40x40.png",
                        "proapp@2x" : "app-icons/167x167.png",
                        "settings" : "app-icons/29x29.png",
                        "settings@2x" : "app-icons/58x58.png",
                        "spotlight" : "app-icons/40x40.png",
                        "spotlight@2x" : "app-icons/80x80.png"
                    },
                    "iphone" : {
                        "app@2x" : "app-icons/120x120.png",
                        "app@3x" : "app-icons/180x180.png",
                        "notification@2x" : "app-icons/40x40.png",
                        "notification@3x" : "app-icons/60x60.png",
                        "settings@2x" : "app-icons/58x58.png",
                        "settings@3x" : "app-icons/87x87.png",
                        "spotlight@2x" : "app-icons/80x80.png",
                        "spotlight@3x" : "app-icons/120x120.png"
                    }
                }
            },
            "splashscreen" : {
                "androidStyle" : "common",
                "android" : {
                    "hdpi" : "app-icons/splash-750x1334.png"
                },
                "iosStyle" : "common",
                "ios" : {
                    "iphone" : {
                        "portrait-750x1334" : "app-icons/splash-750x1334.png"
                    }
                },
                "useOriginalMsgbox" : true
            }
        },
        /* uni-push 2.0 厂商通道：需要 DCloud 后台为各厂商开通后填入，
           缺失的厂商会导致该品牌设备收不到系统通知 */
        "uni-push" : {
            "push-type" : "unipush"
        },
        /* App 隐私弹窗：Android 上首次调用受限 API 时系统会自动叠加一层说明，
           关闭后由前端 PrivacyPopup 自行处理 */
        "safearea" : {
            "bottom" : {
                "offset" : "auto"
            }
        }
    },
    /* 快速应用：App 打包不支持 quickapp，此处仅占位，切勿误以为已启用 */
    "quickapp" : {},
    "uniStatistics" : {
        "enable" : false
    },
    "vueVersion" : "3",
    "locale" : "zh-Hans"
}
