# 开发环境构建配置（Vite mode=dev，由 `npm run dev:*` 的 --mode=dev 加载）
#
# 命名规范（与 .env.prod 对称，字段集合必须完全一致，仅取值不同）：
#   .env.dev  / .env.prod             —— 入库的构建配置
#   .env.dev.local / .env.prod.local —— 个人本地覆盖，不入库，优先级更高
#   .env                             —— **不是**给 Vite 用的，见文件末尾说明
#
# Vite 加载优先级：.env.[mode].local > .env.[mode] > .env
# 所以本地要临时换地址，建 .env.dev.local，不要改这个文件。
#
# ⚠️ 本文件只允许出现 VITE_ 前缀的变量。Vite 只把 VITE_* 注入 import.meta.env，
#    其余变量写在这里不会有任何效果（App 源码里的 UNIVERIFY_*/UNIPUSH_* 是
#    uniCloud 云函数用的，见文件末尾，别往这里加）。

# ── 必填 ────────────────────────────────────────────────────
# 后端 API 根地址。手机无法访问 localhost，必须是局域网可达地址或域名。
# 开发期指向测试服 103.24.218.69（裸 HTTP + 8081）。
# 生产值在 .env.prod，两者字段相同、值不同。
VITE_API_BASE_URL=http://103.24.218.69:8081/api/v1

# ── uni-push 2.0 开关 ───────────────────────────────────────
# 已安装 @dcloudio/uni-push（与 @dcloudio/* 同版本 3.0.0-4080420251103001），
# 且 manifest.json 已声明 app-plus.modules.Push 与 uni-push.push-type，故开启。
# ⚠️ uni-push 2.0 依赖 manifest.json 的 appid 与 DCloud 后台一致
# （当前为 __UNI__F1F9279），才能取到有效 cid 并完成上报。
# 关闭时全部走 no-op，保证工程在插件缺位的情况下仍可编译、可运行。
VITE_PUSH_ENABLED=true

# ── 支付通道（APP-09）───────────────────────────────────────
# 总闸。开发期可开，便于自测捐赠流程；生产必须为 false。
# iOS 数字内容必须走 StoreKit IAP，MVP 阶段默认隐藏捐赠入口。
VITE_DONATE_ENABLED=true
VITE_DONATE_IOS_ENABLED=false
# 原生支付通道未接通前必须为 false（invokeNativePay 目前是 stub）
VITE_DONATE_NATIVE_READY=false

# ── 内置管理后台 ─────────────────────────────────────────────
# src/pages/admin/ 不随 C 端发布包开放：生产构建会在 vite.config.ts 里强制置 false。
# 仅在本地 dev / H5 / 真机自定义基座调试时置 true。
VITE_ADMIN_ENABLED=false

# ── Sign in with Apple（iOS 登录）───────────────────────────
# 开启前必须三步全部完成，详见 src/utils/env.ts 的注释：
#   1. Apple Developer 后台为 __UNI__F1F9279 启用 Sign in with Apple
#   2. 重新生成 provisioning profile，用含该能力的自定义基座/云打包安装
#   3. 取消 src/manifest.json 中 com.apple.developer.applesignin 的注释
# 后端也需配齐 APPLE_CLIENT_ID / APPLE_TEAM_ID / APPLE_KEY_ID /
# APPLE_PRIVATE_KEY_PATH（见后端 .env.prod）。
# 保持 false 时 iOS 登录页不展示 Apple 入口，用户走手机号短信验证码。
VITE_APPLE_LOGIN_ENABLED=false

# ─────────────────────────────────────────────────────────────
# ⚠️ 关于项目根目录的 `.env`
#   它**不是**给 Vite 用的：Vite 会加载它，但只取 VITE_ 前缀的变量，
#   而本文件已经覆盖了全部 VITE_* 字段，所以 .env 对构建结果没有影响。
#
#   `.env` 的真实用途是 uniCloud 云函数：HBuilderX 本地运行
#   univerify-exchange / unipush-send 时，会把项目根目录 .env 的变量
#   作为云函数环境变量注入。因此那个文件名是 DCloud 的约定，不能改。
#
#   云端部署时同理，要在 uniCloud 控制台 → 云函数 → 对应函数 → 环境变量
#   里配同样的值；两处的 UNIVERIFY_SECRET / UNIPUSH_SECRET 必须与 Go 后端
#   一致，否则签名校验对不上，表现为「非法访问」。
#   密钥只存在于该文件（已 gitignore），不要写进本文件。
# ─────────────────────────────────────────────────────────────
