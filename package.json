{
  "name": "idoltrail-app",
  "version": "1.0.0",
  "description": "偶像轨迹 — Android / iOS 独立 App 前端",
  "scripts": {
    "dev:app": "uni -p app --mode=dev",
    "dev:app-android": "uni -p app-android --mode=dev",
    "dev:app-ios": "uni -p app-ios --mode=dev",
    "dev:h5": "uni --mode=dev",
    "build:app": "npm run check:env && uni build -p app --mode=prod",
    "build:app-android": "npm run check:env && uni build -p app-android --mode=prod",
    "build:app-ios": "npm run check:env && uni build -p app-ios --mode=prod",
    "build:h5": "npm run check:env && uni build --mode=prod",
    "check:env": "node scripts/check-env-files.mjs",
    "export:agreements": "node scripts/export-agreements.mjs",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,scss,css,json}\""
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4080420251103001",
    "@dcloudio/uni-app-plus": "3.0.0-4080420251103001",
    "@dcloudio/uni-components": "3.0.0-4080420251103001",
      "@dcloudio/uni-h5": "3.0.0-4080420251103001",
      "@dcloudio/uni-push": "3.0.0-4080420251103001",
    "@dcloudio/uni-ui": "^1.5.12",
    "pinia": "2.2.4",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-4080420251103001",
    "@dcloudio/uni-stacktracey": "3.0.0-4080420251103001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4080420251103001",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.0.0",
    "@vue/runtime-core": "3.4.21",
    "@vue/tsconfig": "^0.1.3",
    "eslint": "^9.10.0",
    "eslint-plugin-vue": "^9.28.0",
    "prettier": "^3.3.3",
    "sass": "^1.101.0",
    "typescript": "^4.9.4",
    "vite": "5.2.8",
    "vue-tsc": "^1.0.24"
  }
}
