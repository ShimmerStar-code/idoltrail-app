# 生产环境构建配置（Vite mode=prod，由 `npm run build:*` 的 --mode=prod 加载）
#
# 命名规范（与 .env.dev 对称，字段集合必须完全一致，仅取值不同）：
#   .env.dev  / .env.prod        —— 入库的构建配置
#   .env.dev.local / .env.prod.local —— 个人本地覆盖，不入库，优先级更高
#
# ⚠️ 为什么生产必须单独一份：
#   .env.dev 指向测试服 103.24.218.69 的裸 HTTP。若生产构建继承了它，
#   生产包会直接带着 http://103.24.218.69:8081/api/v1 发出去：
#     - 明文 HTTP，用户数据（含手机号、验证码登录）在链路上裸奔；
#     - 与隐私政策正文承诺的「全程 HTTPS」直接冲突，属于合规问题；
#     - 隐私政策里写的服务器地址也会与实际不符。
#   vite.config.ts 的 checkApiBaseUrl() 会对此 fail build，改完记得跑一次
#   `npm run build:app` 验证。
#
# ⚠️ 上线前确认：idoltrail.com 已解析到 47.94.165.221，
#    且后端 nginx/conf.d/idoltrail.conf 已生效、证书覆盖该域名。
#    若是别的域名，改这一行即可（vite.config.ts 会校验协议与测试域名）。
#
# ⚠️ 本文件只允许出现 VITE_ 前缀的变量（Vite 只注入 VITE_* 到 import.meta.env）。

# ── 必填 ────────────────────────────────────────────────────
# 生产 API 根地址，必须是 HTTPS 且不得指向测试服/本机。
VITE_API_BASE_URL=https://idoltrail.com/api/v1

# ── uni-push 2.0 ──
# 生产必须开启：关掉的话 App 收不到任何系统推送，通知只在应用内可见。
# 前提是 DCloud 后台已为 __UNI__F1F9279 开通推送，且安装包含 Push 模块
# （标准 HBuilder 运行基座不含，必须用自定义基座或云打包）。
VITE_PUSH_ENABLED=true

# ── 支付通道 ──
# 总闸。iOS 数字内容必须走 StoreKit IAP（App Store 审核硬要求），
# APPLE_IAP_* 与后端对账接口未验证前保持关闭，
# 否则会向用户展示一个点了必然失败的入口。
VITE_DONATE_ENABLED=false
VITE_DONATE_IOS_ENABLED=false
# Android 走微信 App 支付，后端 /donations/wx-app、/donations/alipay
# 的对账接口未落地前必须为 false（invokeNativePay 目前是 stub）。
VITE_DONATE_NATIVE_READY=false

# ── 内置管理后台 ──
# 生产强制关闭（vite.config.ts 的 checkAdminGate 会再按死一次）。
# 注意：这只折叠掉**入口**，pages/admin 的代码与路由仍在包内。
# 彻底消除需要后端对 /admin/* 增加来源校验，并把后台迁到独立 Web 控制台。
VITE_ADMIN_ENABLED=false

# ── Sign in with Apple ──
# 生产保持关闭。开启需同时满足：
#   1. Apple Developer 后台为 __UNI__F1F9279 启用 Sign in with Apple 能力
#   2. 重新生成 provisioning profile 并用云打包出正式包
#   3. 取消 src/manifest.json 中 com.apple.developer.applesignin 的注释
# 未开启时 iOS 登录页不展示 Apple 入口，不会有"点了必失败"的按钮。
VITE_APPLE_LOGIN_ENABLED=false
