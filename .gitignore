# ============================================================
#  依赖
# ============================================================
node_modules/
jspm_packages/

# ============================================================
#  构建产物
# ============================================================
# vite 产物（uni build -p app → dist/build/app）
dist/
# HBuilderX 云打包 / 原生插件编译产物
unpackage/

# ============================================================
#  环境变量
#  命名规范：.env.dev / .env.prod 为入库的构建配置（字段集合必须一致，
#  由 npm run check:env 校验）；.env.[dev|prod].local 为个人覆盖，不入库。
#
#  .env 不入库：它只承载 uniCloud 云函数的环境变量
#  （UNIVERIFY_* / UNIPUSH_* 等 DCloud 密钥），名字是 DCloud 约定不能改，
#  但内容含明文密钥，绝不能进版本库。详见 .env 与 .env.dev 的注释。
#
#  注意这里**不要**再写 !.env.example —— 规范里没有 example 文件，
#  模板与生效配置合并在 .env.dev / .env.prod 本身（两者都不含密钥）。
# ============================================================
.env
.env.local
.env.*.local

# ============================================================
#  日志与调试
# ============================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================================
#  缓存与中间产物
# ============================================================
.eslintcache
*.tsbuildinfo
.cache/
.temp/
.temp-cache/
.sass-cache/
coverage/
*.lcov
stats.html
.nyc_output/

# ============================================================
#  HBuilderX / uni-app 本地状态
#  launch.json 记录本机调试设备，uni-agent 记录会话上下文，
#  都与代码无关，换台机器就失效。
# ============================================================
.hbuilderx/
src/manifest.json.mergeinfo
*.mergeinfo

# ============================================================
#  编辑器 / IDE
# ============================================================
.idea/
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ============================================================
#  操作系统
# ============================================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
#  明确入库（防止被上面的通配规则误伤）
# ============================================================
# 本项目统一用 npm，锁文件必须入库保证各机器依赖树一致
!package-lock.json